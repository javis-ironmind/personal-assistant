# Personal Assistant Configuration
# Copy to .env and fill in values

# Database (can use same as kanban backend)
PA_DB_HOST=localhost
PA_DB_PORT=5432
PA_DB_NAME=kanban
PA_DB_USER=kanban
PA_DB_PASSWORD=your_password_here

# Google OAuth credentials
GOOGLE_CLIENT_SECRET_PATH=/home/ubuntu/.openclaw/credentials/client_secret.json
GOOGLE_ACCOUNT=your_email@gmail.com

# OpenClaw / Agent settings
PA_AGENT_ID=main
PA_TIMEZONE=America/Los_Angeles
PA_REPORT_TIME=06:00

# Optional: Valid contexts for tasks (comma-separated)
PA_CONTEXTS=work,personal,health,finance,travel,family,learning

# Optional: Report delivery (whatsapp, telegram, email)
PA_REPORT_CHANNEL=whatsapp
PA_REPORT_TARGET=+16268725569
